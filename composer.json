{
  "name": "presentkim/item-serialize-utils",
  "description": "Provides utils for (de)serialize items more shorter and easier for axolotl-pm/PocketMine-MP",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": "^8.4",
    "pocketmine/pocketmine-mp": "^5.0",
    "presentkim/nbt-serializer": "^3.0"
  },
  "require-dev": {
    "axolotl-pm/pocketmine-mp": "^5.51",
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": {
      "kim\\present\\utils\\itemserialize\\": "src/kim/present/utils/itemserialize/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "kim\\present\\utils\\itemserialize\\tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "config": {
    "sort-packages": true
  }
}
